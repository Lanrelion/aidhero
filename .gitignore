# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AidHero — project-specific
# Allow the example file to be committed
!.env.local.example
# Generated TTS audio (output of CI/CD pipeline — do NOT commit binary MP3s)
/public/audio/**/*.mp3
# Generated PWA icons (recreated from source SVG in CI)
/public/icons/*.png
# Screenshots (generated by CI)
/public/screenshots/*.png
