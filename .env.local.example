# AidHero Environment Variables
# Copy this file to .env.local and fill in values

# ─── CI/CD Only — NEVER in browser ──────────────────────────────────────────
# This key is used ONLY by scripts/generate-tts-audio.ts at build time
# It should ONLY be set in GitHub Actions secrets — never in .env.local
# GOOGLE_CLOUD_TTS_API_KEY=your-key-here

# ─── Optional Analytics ──────────────────────────────────────────────────────
# Plausible Analytics domain (privacy-first, no PII)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=aidhero.ng
